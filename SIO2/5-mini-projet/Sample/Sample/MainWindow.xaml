<Window x:Class="Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koh-Lanta"
        Width="1000" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#2B2A33"
        Loaded="Fenetre_Loaded">

    <!-- Deux lignes : 20 % en haut (actions + fiche), 80 % en bas (journal). -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*"/>
            <ColumnDefinition Width="935*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <!-- ============ En haut : les actions à gauche, la fiche à droite ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#3A3945" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Epreuve" Click="ButtonEpreuve_Click"/>
                    <Button Content="Lancer l'epreuve" Height="37" Width="116" Click="ButtonLancerEpreuve_Click"/>
                </WrapPanel>
            </Border>

            <!-- La fiche du personnage -->
            <Border Grid.Column="1" Background="#F4EBD0" CornerRadius="6" Padding="8">
                <DockPanel>

                    <Image x:Name="ImageJeux0" Source="/Images/Koh-Lanta.png" />

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock x:Name="TexteNom" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TexteCaracteristiques" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ En bas : le journal des événements (80 %) ============ -->
        <Border Grid.Row="1" Background="#1E1D24" CornerRadius="6" Padding="8" Grid.ColumnSpan="2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Journal (le plus récent en haut)"
                           Foreground="#F4EBD0" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox x:Name="ListeJournal" Background="Transparent" BorderThickness="0"
                         Foreground="#E8E6E3" FontFamily="Consolas" FontSize="14" />
            </DockPanel>
        </Border>
        <TextBox x:Name="nomChoix"  HorizontalAlignment="Left" Margin="47,101,0,0" TextWrapping="Wrap" Text="choix" VerticalAlignment="Top" Width="134" Height="25" Grid.Column="1" />
        <Label Content="Choix" HorizontalAlignment="Left" Margin="16,98,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" FontSize="16" Foreground="White"/>
    </Grid>
</Window>
